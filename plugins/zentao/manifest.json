{
  "id": "antumi.zentao",
  "version": "0.5.1",
  "engines": { "antumi": ">=0.15.11 <1.0.0" },
  "contributes": {
    "sources": [{
      "id": "zentao", "commentSync": 1, "writeback": 1, "writebackComment": false, "name": "禅道",
      "writebackRules": {"start": {"presets": [{"value": "进行中", "label": "开始或继续任务（Bug、需求不变）", "translations": {"en": {"label": "Start or resume a task (bugs and stories unchanged)"}}}], "custom": false}, "review": {"presets": [{"value": "已完成|已解决", "label": "完成任务、解决 Bug", "translations": {"en": {"label": "Finish a task, resolve a bug"}}}], "custom": false}, "done": {"presets": [{"value": "已完成|已解决|已关闭", "label": "完成任务、解决 Bug、关闭需求", "translations": {"en": {"label": "Finish a task, resolve a bug, close a story"}}}], "custom": false, "hint": "不提供关闭 Bug：解决后由创建人验证并关闭。", "translations": {"en": {"hint": "Closing a bug is not offered: its creator verifies and closes it once resolved."}}}},
      "writebackTypes": [
        {"id": "task", "label": "任务", "translations": {"en": {"label": "Task"}}, "rules": {"start": {"presets": [{"value": "进行中", "label": "开始或继续任务", "translations": {"en": {"label": "Start or resume the task"}}}], "custom": false}, "review": {"presets": [{"value": "已完成", "label": "完成任务", "translations": {"en": {"label": "Finish the task"}}}], "custom": false}, "done": {"presets": [{"value": "已完成", "label": "完成任务", "translations": {"en": {"label": "Finish the task"}}}, {"value": "已关闭|已完成", "label": "能关闭就关闭，否则完成任务", "translations": {"en": {"label": "Close if it can be, else finish the task"}}}], "custom": false, "hint": "任务只有完成后才能关闭。", "translations": {"en": {"hint": "A task closes only once finished."}}}}},
        {"id": "bug", "label": "Bug", "translations": {"en": {"label": "Bug"}}, "rules": {"start": false, "review": {"presets": [{"value": "已解决", "label": "解决 Bug", "translations": {"en": {"label": "Resolve the bug"}}}], "custom": false}, "done": false}},
        {"id": "story", "label": "需求", "translations": {"en": {"label": "Story"}}, "rules": {"start": false, "review": false, "done": {"presets": [{"value": "已关闭", "label": "关闭需求", "translations": {"en": {"label": "Close the story"}}}], "custom": false}}}
      ],
      "settings": [
        { "key": "apiBase", "type": "url", "label": "REST API 地址", "required": true, "bindsCredential": true, "placeholder": "https://zentao.example.com/api.php/v1", "hint": "填写完整的 RESTful API v1 地址，支持部署在子目录。修改地址后需要重新登录。", "translations": { "en": { "label": "REST API URL", "hint": "Full RESTful API v1 base URL, including any deployment subdirectory. Changing it signs you out." } } },
        { "key": "kind", "type": "select", "label": "事项类型", "required": true, "default": "task", "options": [{ "value": "task", "label": "任务", "translations": { "en": { "label": "Tasks" } } }, { "value": "bug", "label": "Bug" }, { "value": "story", "label": "需求", "translations": { "en": { "label": "Stories" } } }], "translations": { "en": { "label": "Item type" } } },
        { "key": "scopeId", "type": "text", "label": "执行 / 产品 ID", "required": true, "mono": true, "hint": "同步任务时填写执行 ID；同步 Bug 或需求时填写产品 ID。", "translations": { "en": { "label": "Execution / product ID", "hint": "Execution ID for tasks; product ID for bugs or stories." } } },
        { "key": "assignee", "type": "text", "label": "指派给", "required": false, "default": "@me", "hint": "@me 表示自己，留空表示所有人，也可填写禅道账号。", "translations": { "en": { "label": "Assignee", "hint": "@me for yourself, empty for anyone, or a ZenTao account name." } } },
        { "key": "state", "type": "select", "label": "状态范围", "required": true, "default": "active", "options": [{ "value": "active", "label": "未完成", "translations": { "en": { "label": "Unfinished" } } }, { "value": "all", "label": "全部", "translations": { "en": { "label": "All" } } }], "translations": { "en": { "label": "Status" } } }
      ]
    }]
  },
  "entry": { "runtime": "node", "main": "main.mjs" },
  "env": ["ANTUMI_ZENTAO_TOKEN"]
}
